---
---
<header class="site-header">
  <div class="logo">
    <a href="/">[LOGO] EXECUTIVE</a>
  </div>
  <nav class="main-nav">
    <ul>
      <li><a href="#about">Обо мне</a></li>
      <li><a href="#services">Услуги</a></li>
      <li><a href="#portfolio">Кейсы</a></li>
      <li><a href="/blog">Блог</a></li>
      <li><a href="#contacts" class="btn-outline">Контакты</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 1.5rem 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1000;
    backdrop-filter: blur(12px);
    background: rgba(15, 23, 42, 0.7);
    border-bottom: 1px solid var(--border-color);
  }
  .logo a {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 1px;
  }
  .main-nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .main-nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .main-nav a {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .main-nav a:hover {
    color: var(--accent-cyan);
  }
  .btn-outline {
    border: 1px solid var(--accent-cyan);
    padding: 0.5rem 1.2rem;
    border-radius: 20px;
    color: var(--accent-cyan) !important;
    transition: all 0.3s ease;
  }
  .btn-outline:hover {
    background: rgba(6, 182, 212, 0.1);
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
  }

  /* Адаптивность (Mobile) */
  @media (max-width: 900px) {
    .site-header {
      padding: 1rem;
    }
    .main-nav {
      position: static;
      transform: none;
      display: none; /* В реальном проекте здесь будет бургер-меню */
    }
    /* Для заглушки мобильного вида пока просто скроем меню, чтобы не ломать верстку */
  }
</style>
