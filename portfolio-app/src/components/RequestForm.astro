---
// RequestForm.astro — reusable contact form component
---

<section class="contact-form-section" id="request">
	<h2>Оставить заявку</h2>
	<p class="form-subtitle">Выберите интересующие услуги, опишите задачу — и&nbsp;я&nbsp;вернусь с&nbsp;предложением.</p>

	<form class="request-form" id="requestForm">
		<!-- Выбор услуг -->
		<fieldset class="form-fieldset">
			<legend>Какие услуги интересуют?</legend>
			<div class="checkbox-list">
				<label class="checkbox-item"><input type="checkbox" name="services" value="storefront" /><span>🛍️ Онлайн-витрина: аудит, редизайн, создание с&nbsp;нуля</span></label>
				<label class="checkbox-item"><input type="checkbox" name="services" value="content" /><span>📦 Продукт и&nbsp;контент: товарный контент, фотостудия, контент-стратегия</span></label>
				<label class="checkbox-item"><input type="checkbox" name="services" value="marketing" /><span>📣 Маркетинг: аудит каналов, воронки привлечения</span></label>
				<label class="checkbox-item"><input type="checkbox" name="services" value="client-service" /><span>🤝 Клиентский сервис: CRM, лояльность, омниканальность</span></label>
				<label class="checkbox-item"><input type="checkbox" name="services" value="logistics" /><span>🚚 Логистика: фулфилмент, маркетплейсы</span></label>
				<label class="checkbox-item"><input type="checkbox" name="services" value="dev-ai" /><span>🤖 Разработка и&nbsp;ИИ: архитектура, внедрение ИИ, вайбкодинг</span></label>
				<label class="checkbox-item"><input type="checkbox" name="services" value="complex" /><span>🔀 Комплексно: полный аудит, построение команды</span></label>
			</div>
		</fieldset>

		<!-- Комментарий -->
		<div class="form-group">
			<label for="comment">Расскажите о задаче</label>
			<textarea id="comment" name="comment" rows="4" placeholder="Опишите ваш проект, задачу или вопрос..."></textarea>
		</div>

		<!-- Файл -->
		<div class="form-group">
			<label for="brief">Прикрепить бриф или файл</label>
			<div class="file-upload" id="fileUploadArea">
				<input type="file" id="brief" name="brief" accept=".pdf,.doc,.docx,.xls,.xlsx,.pptx,.txt,.zip" />
				<span class="file-label">📎 Перетащите файл сюда или <u>выберите</u></span>
				<span class="file-hint">PDF, DOC, XLS, PPTX, TXT, ZIP — до 10 МБ</span>
			</div>
		</div>

		<!-- Контакты -->
		<div class="form-row">
			<div class="form-group">
				<label for="name">Имя *</label>
				<input type="text" id="name" name="name" required placeholder="Как к вам обращаться" />
			</div>
			<div class="form-group">
				<label for="email">Email *</label>
				<input type="email" id="email" name="email" required placeholder="your@email.com" />
			</div>
			<div class="form-group">
				<label for="phone">Телефон</label>
				<input type="tel" id="phone" name="phone" placeholder="+7 (___) ___-__-__" />
			</div>
		</div>

		<!-- 152-ФЗ -->
		<label class="consent-label">
			<input type="checkbox" name="consent" required />
			<span>Я&nbsp;даю согласие на&nbsp;обработку <a href="/privacy" target="_blank">персональных данных</a> в&nbsp;соответствии с&nbsp;Федеральным законом №152-ФЗ «О&nbsp;персональных данных»</span>
		</label>

		<button type="submit" class="submit-btn">Отправить заявку</button>
	</form>
</section>

<style>
	.contact-form-section {
		max-width: 700px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	.contact-form-section h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.6rem;
		color: var(--text-primary);
		margin-bottom: 0.5rem;
		text-align: center;
	}
	.form-subtitle {
		text-align: center;
		color: var(--text-secondary);
		margin-bottom: 2.5rem;
		font-size: 0.95rem;
	}

	/* Fieldset */
	.form-fieldset {
		border: none;
		padding: 0;
		margin-bottom: 1.5rem;
	}
	.form-fieldset legend {
		font-family: 'Outfit', sans-serif;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--text-primary);
		padding: 0;
		margin-bottom: 0.5rem;
	}
	.checkbox-list {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		margin-top: 1rem;
	}
	.checkbox-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.4;
		transition: color 0.2s;
	}
	.checkbox-item:hover {
		color: var(--text-primary);
	}
	.checkbox-item input[type="checkbox"] {
		accent-color: var(--neon-cyan);
		flex-shrink: 0;
	}

	/* Form groups */
	.form-group {
		margin-bottom: 1.5rem;
	}
	.form-group label {
		display: block;
		font-family: 'Outfit', sans-serif;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--text-primary);
		margin-bottom: 0.5rem;
	}
	.form-group input,
	.form-group textarea {
		width: 100%;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		padding: 0.75rem 1rem;
		color: var(--text-primary);
		font-family: 'Inter', sans-serif;
		font-size: 0.9rem;
		transition: border-color 0.3s;
		outline: none;
	}
	.form-group input:focus,
	.form-group textarea:focus {
		border-color: var(--neon-cyan);
	}
	.form-group textarea {
		resize: vertical;
		min-height: 100px;
	}
	.form-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
	}
	.form-row .form-group {
		margin-bottom: 1rem;
	}

	/* File upload */
	.file-upload {
		position: relative;
		border: 2px dashed rgba(255, 255, 255, 0.08);
		border-radius: 10px;
		padding: 1.5rem;
		text-align: center;
		cursor: pointer;
		transition: all 0.3s;
	}
	.file-upload:hover {
		border-color: rgba(0, 240, 255, 0.2);
		background: rgba(0, 240, 255, 0.02);
	}
	.file-upload input[type="file"] {
		position: absolute;
		inset: 0;
		opacity: 0;
		cursor: pointer;
	}
	.file-label {
		display: block;
		color: var(--text-secondary);
		font-size: 0.9rem;
		margin-bottom: 0.3rem;
	}
	.file-hint {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.25);
	}

	/* Consent */
	.consent-label {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: 0.8rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin-bottom: 2rem;
		cursor: pointer;
	}
	.consent-label input {
		accent-color: var(--neon-cyan);
		margin-top: 2px;
		flex-shrink: 0;
	}
	.consent-label a {
		color: var(--neon-cyan);
		text-decoration: underline;
	}

	/* Submit */
	.submit-btn {
		display: block;
		width: 100%;
		padding: 1rem;
		background: linear-gradient(135deg, rgba(0, 240, 255, 0.15), rgba(192, 132, 252, 0.15));
		border: 1px solid rgba(0, 240, 255, 0.25);
		border-radius: 10px;
		color: var(--text-primary);
		font-family: 'Outfit', sans-serif;
		font-weight: 600;
		font-size: 1rem;
		letter-spacing: 1px;
		cursor: pointer;
		transition: all 0.3s;
	}
	.submit-btn:hover {
		background: linear-gradient(135deg, rgba(0, 240, 255, 0.25), rgba(192, 132, 252, 0.25));
		border-color: rgba(0, 240, 255, 0.4);
		box-shadow: 0 0 30px rgba(0, 240, 255, 0.1);
		transform: translateY(-1px);
	}

	@media (max-width: 768px) {
		.contact-form-section { padding: 3rem 1.5rem; }
		.form-row { grid-template-columns: 1fr; }
	}
</style>

<script>
	const initForm = () => {
		const form = document.getElementById('requestForm') as HTMLFormElement;
		if (!form) return;

		form.addEventListener('submit', (e) => {
			e.preventDefault();

			const formData = new FormData(form);
			const services = formData.getAll('services');
			const data = {
				services,
				comment: formData.get('comment'),
				name: formData.get('name'),
				email: formData.get('email'),
				phone: formData.get('phone'),
			};

			// TODO: подключить бэкенд (Formspree / Netlify Forms / собственный)
			console.log('Form data:', data);

			const btn = form.querySelector('.submit-btn') as HTMLButtonElement;
			if (btn) {
				btn.textContent = '✓ Заявка отправлена!';
				btn.style.background = 'rgba(0, 240, 255, 0.15)';
				btn.disabled = true;
			}
		});

		// File upload visual feedback
		const fileInput = document.getElementById('brief') as HTMLInputElement;
		const fileLabel = document.querySelector('.file-label');
		if (fileInput && fileLabel) {
			fileInput.addEventListener('change', () => {
				if (fileInput.files && fileInput.files.length > 0) {
					fileLabel.textContent = `📄 ${fileInput.files[0].name}`;
				}
			});
		}
	};
	document.addEventListener('DOMContentLoaded', initForm);
	document.addEventListener('astro:page-load', initForm);

	// Russian phone mask +7 (___) ___-__-__
	function initPhoneMask() {
		const phone = document.getElementById('phone') as HTMLInputElement;
		if (!phone) return;

		phone.addEventListener('focus', () => {
			if (!phone.value) phone.value = '+7 (';
		});

		phone.addEventListener('input', (e) => {
			const input = e.target as HTMLInputElement;
			let digits = input.value.replace(/\D/g, '');

			// Strip leading 7 or 8 (user typed it by habit, mask already has +7)
			if (digits.startsWith('78') || digits.startsWith('77')) {
				digits = '7' + digits.slice(2);
			} else if (digits.startsWith('8')) {
				digits = '7' + digits.slice(1);
			} else if (!digits.startsWith('7')) {
				digits = '7' + digits;
			}
			if (digits.length > 11) digits = digits.slice(0, 11);

			let formatted = '+7';
			if (digits.length > 1) formatted += ' (' + digits.slice(1, 4);
			if (digits.length >= 4) formatted += ') ';
			if (digits.length > 4) formatted += digits.slice(4, 7);
			if (digits.length > 7) formatted += '-' + digits.slice(7, 9);
			if (digits.length > 9) formatted += '-' + digits.slice(9, 11);

			input.value = formatted;
		});

		phone.addEventListener('keydown', (e) => {
			const input = e.target as HTMLInputElement;
			if (e.key === 'Backspace') {
				e.preventDefault();
				let digits = input.value.replace(/\D/g, '');
				if (digits.length <= 1) {
					input.value = '';
					return;
				}
				digits = digits.slice(0, -1); // remove last digit

				let formatted = '+7';
				if (digits.length > 1) formatted += ' (' + digits.slice(1, 4);
				if (digits.length >= 4) formatted += ') ';
				if (digits.length > 4) formatted += digits.slice(4, 7);
				if (digits.length > 7) formatted += '-' + digits.slice(7, 9);
				if (digits.length > 9) formatted += '-' + digits.slice(9, 11);

				input.value = formatted;
			}
		});

		phone.addEventListener('blur', () => {
			if (phone.value === '+7 (' || phone.value === '+7') phone.value = '';
		});
	}
	document.addEventListener('DOMContentLoaded', initPhoneMask);
	document.addEventListener('astro:page-load', initPhoneMask);
</script>
