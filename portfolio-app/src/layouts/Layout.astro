---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const {
	title,
	description = 'Илья Кадацкий — руководитель электронной торговли. 18 лет в диджитале: от создания сайтов до управления федеральными e-commerce проектами.',
	ogImage = '/og-image.png',
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://my-portfolio-seven-rho-enkotkigkq.vercel.app');
const ogImageURL = new URL(ogImage, Astro.site || 'https://my-portfolio-seven-rho-enkotkigkq.vercel.app');
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL.href} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL.href} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:locale" content="ru_RU" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL.href} />

		<!-- Fonts preconnect -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- JSON-LD: Person -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Илья Кадацкий",
			"jobTitle": "Руководитель электронной торговли",
			"url": canonicalURL.origin,
			"sameAs": [
				"https://t.me/ivkadatsky"
			],
			"email": "ilya.kadatsky@yandex.ru",
			"knowsAbout": ["E-commerce", "Digital Marketing", "AI", "Logistics", "PIM"]
		})} />
	</head>
	<body>
		<Header />
		<slot />
	</body>
</html>

<style is:global>
	html, body {
		height: 100%;
	}
	body:has(.fullpage-container) {
		overflow: hidden;
		height: 100vh;
	}
</style>

