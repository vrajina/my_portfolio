---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import RequestForm from '../components/RequestForm.astro';

const serviceGroups = [
	{
		icon: '🛍️',
		floor: '01',
		title: 'Онлайн-витрины',
		anchor: 'storefront',
		services: [
			{ id: 'ux-audit', name: 'UX/UI-аудит онлайн-витрин', desc: 'Покажу, где вы\u00A0теряете деньги\u00A0— на\u00A0сайте, в\u00A0приложении, в\u00A0Telegram-магазине. Полный разбор пользовательского пути по\u00A0всем точкам контакта: от\u00A0первого клика до\u00A0оплаты. Конкретные рекомендации, а\u00A0не\u00A0абстрактные «улучшите юзабилити».' },
			{ id: 'shop-from-scratch', name: 'Создание онлайн-витрины с\u00A0нуля', desc: 'Спроектирую и\u00A0запущу конверсионную витрину\u00A0— сайт, мобильное приложение или магазин в\u00A0мессенджере. От\u00A0прототипа до\u00A0первого заказа, без раздутых бюджетов и\u00A0годовой разработки.' },
			{ id: 'redesign', name: 'Редизайн и\u00A0перезапуск', desc: 'Ваш магазин работает, но\u00A0выглядит как\u00A02018-й? Обновлю дизайн, ускорю загрузку, перестрою каталог\u00A0— на\u00A0любой платформе. Так, чтобы конверсия выросла, а\u00A0не\u00A0просто «стало красиво».' },
		]
	},
	{
		icon: '📦',
		floor: '02',
		title: 'Продукт и\u00A0контент',
		anchor: 'content',
		services: [
			{ id: 'pim', name: 'Управление товарным контентом', desc: 'Настрою управление товарным контентом: от\u00A0фотосъёмки до\u00A0карточки товара. Структура данных, обогащение, публикация\u00A0— на\u00A0тысячи SKU без хаоса.' },
			{ id: 'photo-studio', name: 'Запуск контентной фотостудии', desc: 'Помогу организовать собственную фотостудию: оборудование, процессы, стандарты съёмки. Контент, который продаёт, а\u00A0не\u00A0просто заполняет карточку.' },
			{ id: 'content-strategy', name: 'Контент-стратегия для каталога', desc: 'Какие фото нужны, сколько ракурсов, нужно\u00A0ли видео, как описывать товар\u00A0— разработаю стандарты контента, которые реально влияют на\u00A0продажи.' },
		]
	},
	{
		icon: '📣',
		floor: '03',
		title: 'Маркетинг',
		anchor: 'marketing',
		services: [
			{ id: 'marketing-audit', name: 'Аудит маркетинговых каналов', desc: 'Разберу ваши рекламные кампании, SEO, соцсети и\u00A0маркетплейсы. Покажу, где сливается бюджет и\u00A0где точки роста. Не\u00A0теория\u00A0— цифры и\u00A0план.' },
			{ id: 'funnel', name: 'Построение воронки привлечения', desc: 'Выстрою систему лидогенерации: от\u00A0первого касания до\u00A0покупки. SEO, контекст, таргет, маркетплейсы\u00A0— каждый канал на\u00A0своём месте.' },
		]
	},
	{
		icon: '🤝',
		floor: '04',
		title: 'Клиентский сервис',
		anchor: 'client-service',
		services: [
			{ id: 'crm-loyalty', name: 'Внедрение CRM и\u00A0программы лояльности', desc: 'Настрою систему, которая превращает разовых покупателей в\u00A0постоянных. CRM, сегментация, триггеры, бонусные механики\u00A0— без «спама на\u00A0всю базу».' },
			{ id: 'omnichannel', name: 'Омниканальные коммуникации', desc: 'Объединю онлайн и\u00A0офлайн в\u00A0единый клиентский опыт. Одна программа лояльности, одна история покупок\u00A0— хоть в\u00A0приложении, хоть в\u00A0магазине на\u00A0Тверской.' },
			{ id: 'service-audit', name: 'Аудит клиентского сервиса', desc: 'Пройду путь вашего клиента сам: от\u00A0первого звонка до\u00A0возврата. Найду, где теряется лояльность, и\u00A0предложу конкретные исправления.' },
		]
	},
	{
		icon: '🚚',
		floor: '05',
		title: 'Склад и\u00A0логистика',
		anchor: 'logistics',
		services: [
			{ id: 'fulfillment', name: 'Оптимизация фулфилмента', desc: 'Проанализирую вашу цепочку «заказ → доставка» и\u00A0найду узкие места. Иногда рост продаж\u00A0— это не\u00A0реклама, а\u00A0просто товар в\u00A0наличии.' },
			{ id: 'marketplaces', name: 'Интеграция с\u00A0маркетплейсами', desc: 'Подключу к\u00A0Wildberries, Ozon, Яндекс Маркету\u00A0— или наведу порядок в\u00A0том, что уже подключено. Остатки, цены, контент\u00A0— всё в\u00A0одном месте.' },
		]
	},
	{
		icon: '🤖',
		floor: '06',
		title: 'Разработка и\u00A0ИИ',
		anchor: 'dev-ai',
		services: [
			{ id: 'it-architecture', name: 'Проектирование IT-архитектуры', desc: 'Спроектирую техническую архитектуру \u003Cnobr\u003Ee-commerce\u003C/nobr\u003E: от\u00A0монолита до\u00A0микросервисов. Без оверинжиниринга\u00A0— ровно столько, сколько нужно бизнесу сейчас.' },
			{ id: 'ai-integration', name: 'Внедрение ИИ в\u00A0бизнес-процессы', desc: 'Покажу, где ИИ реально экономит время и\u00A0деньги: генерация контента, аналитика, автоматизация рутины. Не\u00A0хайп\u00A0— конкретные внедрения с\u00A0измеримым результатом.' },
			{ id: 'vibecoding', name: 'Вайбкодинг и\u00A0быстрое прототипирование', desc: 'Нужен MVP за\u00A0дни, а\u00A0не\u00A0за\u00A0полгода? Соберу рабочий прототип с\u00A0помощью ИИ-инструментов\u00A0— чтобы проверить гипотезу до\u00A0того, как вы\u00A0потратите бюджет на\u00A0«настоящую» разработку.' },
		]
	},
];

const crossServices = [
	{ id: 'full-audit', name: 'Полный \u003Cnobr\u003Ee-commerce\u003C/nobr\u003E аудит', desc: 'Комплексная проверка всех этажей айсберга: от\u00A0витрины до\u00A0логистики. Результат\u00A0— приоритизированный roadmap с\u00A0оценкой сроков и\u00A0бюджетов.' },
	{ id: 'build-team', name: 'Построение \u003Cnobr\u003Ee-commerce\u003C/nobr\u003E подразделения', desc: 'Помогу собрать команду с\u00A0нуля: оргструктура, найм, онбординг, процессы. От\u00A0первого сотрудника до\u00A0работающего механизма.' },
];

const allServices = [
	...serviceGroups.flatMap(g => g.services),
	...crossServices,
];
---

<Layout title="Услуги — Илья Кадацкий | Руководитель e-commerce" description="Консалтинг, аудит и управление e-commerce проектами. UX-аудит, товарный контент, маркетинг, CRM, логистика, ИИ — полный цикл электронной торговли.">
	<main class="services-page">

		<!-- Hero -->
		<section class="services-hero">
			<span class="hero-tag">Услуги</span>
			<h1>Каждый этаж айсберга&nbsp;— отдельная экспертиза</h1>
			<p class="hero-desc">Выберите глубину, на&nbsp;которой нужна помощь.&nbsp;Или закажите полное погружение.</p>
		</section>

		<!-- Услуги по этажам -->
		{serviceGroups.map((group) => (
			<section class="floor-section" id={group.anchor}>
				<div class="floor-header">
					<span class="floor-icon">{group.icon}</span>
					<div>
						<span class="floor-num">{group.floor}</span>
						<h2 set:html={group.title} />
					</div>
				</div>
				<div class="services-grid">
					{group.services.map((s) => (
						<div class="service-card">
							<h3 set:html={s.name} />
							<p set:html={s.desc} />
						</div>
					))}
				</div>
			</section>
		))}

		<!-- Сквозные -->
		<section class="floor-section floor-section--cross" id="complex">
			<div class="floor-header">
				<span class="floor-icon">🔀</span>
				<div>
					<span class="floor-num">∞</span>
					<h2>Сквозные услуги</h2>
				</div>
			</div>
			<div class="services-grid">
				{crossServices.map((s) => (
					<div class="service-card service-card--cross">
						<h3 set:html={s.name} />
						<p set:html={s.desc} />
					</div>
				))}
			</div>
		</section>

		<RequestForm />

	</main>
	<Footer />
</Layout>

<style>
	.services-page {
		padding-top: 5rem;
	}

	/* ===== HERO ===== */
	.services-hero {
		text-align: center;
		padding: 4rem 2rem 3rem;
		max-width: 700px;
		margin: 0 auto;
	}
	.hero-tag {
		font-family: 'Outfit', sans-serif;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: var(--neon-cyan);
		border: 1px solid rgba(0, 240, 255, 0.2);
		padding: 0.4rem 1rem;
		border-radius: 20px;
		display: inline-block;
		margin-bottom: 2rem;
	}
	h1 {
		font-family: 'Outfit', sans-serif;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		color: var(--text-primary);
		margin-bottom: 1rem;
		line-height: 1.2;
	}
	.hero-desc {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--text-secondary);
	}

	/* ===== FLOOR SECTIONS ===== */
	.floor-section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 3rem 2rem 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.04);
	}
	.floor-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.floor-icon {
		font-size: 2rem;
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 14px;
		flex-shrink: 0;
	}
	.floor-num {
		font-family: 'Outfit', monospace;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 3px;
		color: rgba(255, 255, 255, 0.2);
		text-transform: uppercase;
	}
	.floor-header h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.3rem;
		color: var(--text-primary);
		margin: 0;
	}

	/* ===== SERVICE CARDS ===== */
	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1rem;
	}
	.service-card {
		padding: 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.015);
		transition: all 0.3s ease;
	}
	.service-card:hover {
		background: rgba(0, 240, 255, 0.03);
		border-color: rgba(0, 240, 255, 0.12);
		transform: translateY(-2px);
	}
	.service-card h3 {
		font-family: 'Outfit', sans-serif;
		font-size: 1rem;
		font-weight: 600;
		color: var(--neon-cyan);
		margin-bottom: 0.75rem;
	}
	.service-card p {
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--text-secondary);
		margin: 0;
	}
	.service-card--cross {
		border-color: rgba(192, 132, 252, 0.12);
	}
	.service-card--cross:hover {
		background: rgba(192, 132, 252, 0.04);
		border-color: rgba(192, 132, 252, 0.2);
	}
	.service-card--cross h3 {
		color: var(--accent-neon, #c084fc);
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 768px) {
		.services-hero { padding: 3rem 1.5rem 2rem; }
		.floor-section { padding: 2rem 1.5rem 1.5rem; }
		.services-grid { grid-template-columns: 1fr; }
	}
</style>
