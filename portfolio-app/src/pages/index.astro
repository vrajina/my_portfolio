---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Илья Кадацкий | E-commerce Executive">
	<main class="fullpage-container" id="fullpage">

		<!-- Экран 1: Вершина айсберга -->
		<section class="screen screen-1" data-index="0">
			<div class="glass-panel">
				<h1>Это главный экран личного сайта Ильи Кадацкого</h1>
				<p class="annotation">Здесь пользователь увидит визуализацию клиентского опыта в екоме в виде иллюстрации, но наша цель: показать то, что от пользователя скрыто. Сложные и современные процессы, технологии, которые сейчас и формируют электронную коммерцию...</p>
				<div class="nav-buttons">
					<button class="nav-btn dive-btn" data-target="4" aria-label="Погрузиться на дно">Погрузиться ↓</button>
				</div>
			</div>
			<div class="floor-indicator">01 / 05</div>
		</section>

		<!-- Экран 2: Продукт и Контент -->
		<section class="screen screen-2" data-index="1">
			<div class="glass-panel">
				<span class="floor-label">Этаж −1</span>
				<h2>Как театр начинается с вешалки, так и еком начинается с продукта...</h2>
				<p class="annotation">Можно сколько угодно спорить о конверсионности тех или иных интерфейсов, качестве трафика и&nbsp;тд и&nbsp;тд. Но основной успех всё ещё определяет его величество спрос: на сколько ваш продукт в него попадает, на сколько он конкурентно способен? А диджитал-контент&nbsp;— это виртуальная аватара вашего продукта, которая связывает ожидания клиента с реальностью...</p>
			</div>
			<div class="floor-indicator">02 / 05</div>
		</section>

		<!-- Экран 3: Поддержка и Коммуникации -->
		<section class="screen screen-3" data-index="2">
			<div class="glass-panel">
				<span class="floor-label">Этаж −2</span>
				<h2>Поддержка и клиентский сервис, коммуникации</h2>
				<p class="annotation">Какой еком обходится сейчас без этого? Забавно, мы так увлеклись автоматизацией и оптимизацией коммуникаций, что люди начинают скучать по старым-добрым операторам колл-центра из плоти и крови... При условии, что их не превратили регламентами и тон оф войсами в биороботов, конечно.</p>
			</div>
			<div class="floor-indicator">03 / 05</div>
		</section>

		<!-- Экран 4: Логистика и Доставка -->
		<section class="screen screen-4" data-index="3">
			<div class="glass-panel">
				<span class="floor-label">Этаж −3</span>
				<h2>Складская логистика и доставка</h2>
				<p class="annotation">Куда без неё? Товар должен быть в наличии, в нужном цвете, нужном размере, он должен быть красиво упакован... А привезти его должны были ещё вчера. Все мы сами создали у клиентов завышенные ожидания от этого этапа покупки, нам и пожинать плоды...</p>
			</div>
			<div class="floor-indicator">04 / 05</div>
		</section>

		<!-- Экран 5: ИИ-Ядро и Разработка -->
		<section class="screen screen-5" data-index="4">
			<div class="glass-panel reactor-panel">
				<span class="floor-label floor-label--reactor">Этаж −4 · Core</span>
				<h2>Ох, а вот мы добрались и до айти...</h2>
				<p class="annotation">То, что раньше было долго, дорого, сложно и непонятно, сегодня стремительно упрощается, ускоряется, становится дешевле. Энтерпрайз-разработка должна умереть и переродиться, не так ли? Потому здесь мы видим манящее мерцание этого ИИ-реактора: средоточие и источник наших вычислительных мощностей...</p>
				<div class="nav-buttons">
					<button class="nav-btn surface-btn" data-target="0" aria-label="Всплыть на поверхность">Всплыть ↑</button>
				</div>
			</div>
			<div class="floor-indicator">05 / 05</div>
		</section>

		<!-- Экран 6: Футер -->
		<section class="screen screen-footer" data-index="5">
			<Footer />
		</section>

		<!-- Боковые точки-индикаторы -->
		<nav class="dot-nav" aria-label="Навигация по этажам">
			<button class="dot active" data-target="0" aria-label="Экран 1"></button>
			<button class="dot" data-target="1" aria-label="Экран 2"></button>
			<button class="dot" data-target="2" aria-label="Экран 3"></button>
			<button class="dot" data-target="3" aria-label="Экран 4"></button>
			<button class="dot" data-target="4" aria-label="Экран 5"></button>
			<button class="dot dot--footer" data-target="5" aria-label="Футер"></button>
		</nav>

	</main>
</Layout>

<style>
	/* ===== FULLPAGE SCROLL-SNAP CONTAINER ===== */
	.fullpage-container {
		width: 100%;
		height: 100vh;
		overflow-y: scroll;
		scroll-snap-type: y mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
	}

	/* ===== INDIVIDUAL SCREENS ===== */
	.screen {
		width: 100%;
		height: 100vh;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		transition: background-color 0.6s ease;
	}

	/* ===== SCREEN BACKGROUNDS (temporary — will be replaced with illustrations) ===== */
	.screen-1 {
		background: linear-gradient(180deg, 
			#0a1628 0%, 
			#0d2137 40%, 
			#0f2b4a 100%);
	}

	.screen-2 {
		background: linear-gradient(180deg, 
			#0f2b4a 0%, 
			#0a2a3f 40%, 
			#082838 100%);
	}

	.screen-3 {
		background: linear-gradient(180deg, 
			#082838 0%, 
			#071e30 40%, 
			#061828 100%);
	}

	.screen-4 {
		background: linear-gradient(180deg, 
			#061828 0%, 
			#051420 40%, 
			#040e18 100%);
	}

	.screen-5 {
		background: linear-gradient(180deg, 
			#040e18 0%, 
			#08051a 40%, 
			#0d0520 100%);
	}

	.screen-footer {
		background: linear-gradient(180deg, 
			#0d0520 0%, 
			#030712 100%);
		scroll-snap-align: start;
	}

	/* ===== GLASS PANELS ===== */
	.glass-panel {
		max-width: 680px;
		padding: 3rem 2.5rem;
		background: rgba(255, 255, 255, 0.04);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 24px;
		text-align: center;
	}

	.reactor-panel {
		border-color: rgba(139, 92, 246, 0.3);
		box-shadow: 
			0 0 60px rgba(139, 92, 246, 0.15),
			inset 0 0 30px rgba(139, 92, 246, 0.05);
	}

	/* ===== TYPOGRAPHY ===== */
	h1 {
		font-size: clamp(1.8rem, 4vw, 3rem);
		line-height: 1.2;
		margin-bottom: 1.5rem;
		color: var(--text-primary, #f1f5f9);
		font-family: 'Outfit', sans-serif;
	}

	h2 {
		font-size: clamp(1.4rem, 3vw, 2.2rem);
		line-height: 1.3;
		margin-bottom: 1.2rem;
		color: var(--accent-cyan, #06b6d4);
		font-family: 'Outfit', sans-serif;
	}

	.reactor-panel h2 {
		color: var(--accent-neon, #8b5cf6);
	}

	.annotation {
		font-size: clamp(0.95rem, 1.8vw, 1.15rem);
		line-height: 1.7;
		color: var(--text-secondary, #94a3b8);
		max-width: 560px;
		margin: 0 auto;
	}

	.floor-label {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 3px;
		color: var(--accent-cyan, #06b6d4);
		margin-bottom: 1.5rem;
		padding: 0.4rem 1rem;
		border: 1px solid rgba(6, 182, 212, 0.3);
		border-radius: 20px;
	}

	.floor-label--reactor {
		color: var(--accent-neon, #8b5cf6);
		border-color: rgba(139, 92, 246, 0.3);
	}

	/* ===== FLOOR INDICATOR (bottom-right) ===== */
	.floor-indicator {
		position: absolute;
		bottom: 2rem;
		right: 2rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 2px;
		color: rgba(255, 255, 255, 0.15);
		font-family: 'Outfit', monospace;
	}

	/* ===== NAVIGATION BUTTONS ===== */
	.nav-buttons {
		margin-top: 2rem;
	}

	.nav-btn {
		padding: 0.8rem 2rem;
		border-radius: 30px;
		font-weight: 600;
		font-size: 0.95rem;
		cursor: pointer;
		font-family: 'Outfit', sans-serif;
		transition: all 0.3s ease;
		letter-spacing: 1px;
	}

	.dive-btn {
		background: rgba(6, 182, 212, 0.15);
		border: 1px solid rgba(6, 182, 212, 0.4);
		color: var(--accent-cyan, #06b6d4);
	}

	.dive-btn:hover {
		background: rgba(6, 182, 212, 0.25);
		box-shadow: 0 0 30px rgba(6, 182, 212, 0.2);
	}

	.surface-btn {
		background: rgba(139, 92, 246, 0.15);
		border: 1px solid rgba(139, 92, 246, 0.4);
		color: var(--accent-neon, #8b5cf6);
	}

	.surface-btn:hover {
		background: rgba(139, 92, 246, 0.25);
		box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);
	}

	/* ===== DOT NAVIGATION ===== */
	.dot-nav {
		position: fixed;
		right: 1.5rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 12px;
		z-index: 1000;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		border: 1px solid rgba(255, 255, 255, 0.2);
		cursor: pointer;
		padding: 0;
		transition: all 0.4s ease;
	}

	.dot:hover {
		background: rgba(6, 182, 212, 0.4);
		transform: scale(1.3);
	}

	.dot.active {
		background: var(--accent-cyan, #06b6d4);
		border-color: var(--accent-cyan, #06b6d4);
		box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
		transform: scale(1.2);
	}

	.dot--footer.active {
		background: var(--accent-neon, #8b5cf6);
		border-color: var(--accent-neon, #8b5cf6);
		box-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 768px) {
		.glass-panel {
			margin: 0 1rem;
			padding: 2rem 1.5rem;
		}

		.dot-nav {
			right: 0.75rem;
			gap: 10px;
		}

		.dot {
			width: 8px;
			height: 8px;
		}

		.floor-indicator {
			bottom: 1rem;
			right: 1rem;
			font-size: 0.7rem;
		}
	}
</style>

<script>
	const init = () => {
		const container = document.getElementById('fullpage');
		if (!container) return;

		const screens = container.querySelectorAll('.screen');
		const dots = document.querySelectorAll('.dot');
		const navBtns = document.querySelectorAll('.nav-btn');

		// Update active dot on scroll
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const index = (entry.target as HTMLElement).dataset.index;
					dots.forEach(dot => dot.classList.remove('active'));
					const activeDot = document.querySelector(`.dot[data-target="${index}"]`);
					if (activeDot) activeDot.classList.add('active');
				}
			});
		}, {
			root: container,
			threshold: 0.6
		});

		screens.forEach(screen => observer.observe(screen));

		// Dot click navigation
		dots.forEach(dot => {
			dot.addEventListener('click', () => {
				const target = (dot as HTMLElement).dataset.target;
				const targetScreen = screens[Number(target)];
				if (targetScreen) {
					targetScreen.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});

		// Nav button navigation (Погрузиться / Всплыть)
		navBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const target = (btn as HTMLElement).dataset.target;
				const targetScreen = screens[Number(target)];
				if (targetScreen) {
					targetScreen.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});
	};

	document.addEventListener('DOMContentLoaded', init);
	document.addEventListener('astro:page-load', init);
</script>
