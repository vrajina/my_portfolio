---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Илья Кадацкий — руководитель e-commerce. 18 лет в диджитале" ogImage="/og-image.png">
	<main class="fullpage-container" id="fullpage">

		<!-- Экран 1: Поверхность -->
		<section class="screen screen-1" data-index="0">
			<div class="screen-bg">
				<img src="/floor-1-surface.jpg" alt="Эскиз верхушки e-commerce айсберга: покупатель видит только витрину интернет-магазина" />
			</div>
			<div class="screen-overlay panel-right">
				<div class="panel">
					<div class="text-inner">
						<span class="floor-tag">01 / 06</span>
						<h1>Покупатель видит витрину. Я&nbsp;вижу всё, что под&nbsp;ней</h1>
						<p class="annotation">Современный <nobr>e-commerce</nobr>&nbsp;— это айсберг. На&nbsp;поверхности&nbsp;— простой и&nbsp;удобный интерфейс: каталог, корзина, оплата. Но&nbsp;под&nbsp;водой&nbsp;— десятки бизнес-процессов, пересечение маркетинга, логистики, IT, контента и&nbsp;клиентского сервиса. Я&nbsp;провёл 18&nbsp;лет, погружаясь в&nbsp;эту глубину. Предлагаю нырнуть вместе.</p>
						<div class="nav-buttons">
							<button class="nav-btn dive-btn" data-target="1">Погрузиться ↓</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Экран 2: Продукт и контент -->
		<section class="screen screen-2" data-index="1">
			<div class="screen-bg">
				<img src="/floor-2-product.jpg" alt="Подводный уровень айсберга: фотостудия, PIM-система и создание диджитал-контента" />
			</div>
			<div class="screen-overlay panel-left">
				<div class="panel">
					<div class="text-inner">
						<span class="floor-tag">02 / 06</span>
						<h2>Как театр начинается с&nbsp;вешалки, так и&nbsp;<nobr>e-commerce</nobr>&nbsp;— с&nbsp;продукта</h2>
						<p class="annotation">Можно бесконечно спорить о&nbsp;конверсионности интерфейсов и&nbsp;качестве трафика. Но&nbsp;успех определяет его величество спрос: насколько ваш продукт в&nbsp;него попадает? Диджитал-контент&nbsp;— это виртуальный аватар вашего товара. Я&nbsp;строил фотостудии с&nbsp;нуля, выстраивал PIM-процессы на&nbsp;тысячи SKU и&nbsp;создавал контент, который продаёт,&nbsp;— а&nbsp;не&nbsp;просто красиво выглядит.</p>
						<div class="nav-buttons">
							<button class="nav-btn surface-btn" data-target="0">Всплыть ↑</button>
							<button class="nav-btn dive-btn" data-target="2">Погрузиться ↓</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Экран 3: Маркетинг -->
		<section class="screen screen-3" data-index="2">
			<div class="screen-bg">
				<img src="/floor-3-marketing.jpg" alt="Глубинный уровень айсберга: маркетинговые каналы, SEO, таргет и бренд-стратегия" />
			</div>
			<div class="screen-overlay panel-right">
				<div class="panel">
					<div class="text-inner">
						<span class="floor-tag">03 / 06</span>
						<h2>Трафик не&nbsp;появляется из&nbsp;ниоткуда, а&nbsp;бренд не&nbsp;строится сам</h2>
						<p class="annotation">SEO, контекст, таргет, маркетплейсы, инфлюенсеры&nbsp;— каналов десятки, и&nbsp;каждый живёт по&nbsp;своим правилам. Я&nbsp;выстраивал воронки привлечения и&nbsp;удержания, управлял рекламными бюджетами и&nbsp;доказывал бизнесу, что вложения в&nbsp;бренд окупаются,&nbsp;— даже когда ROI нельзя посчитать за&nbsp;неделю.</p>
						<div class="nav-buttons">
							<button class="nav-btn surface-btn" data-target="1">Всплыть ↑</button>
							<button class="nav-btn dive-btn" data-target="3">Погрузиться ↓</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Экран 4: Клиентский сервис -->
		<section class="screen screen-4" data-index="3">
			<div class="screen-bg">
				<img src="/floor-4-service.jpg" alt="Подводный этаж айсберга: CRM, чат-боты, программы лояльности и омниканальные коммуникации" />
			</div>
			<div class="screen-overlay panel-left">
				<div class="panel">
					<div class="text-inner">
						<span class="floor-tag">04 / 06</span>
						<h2>Мы&nbsp;так увлеклись автоматизацией, что люди заскучали по&nbsp;живым операторам</h2>
						<p class="annotation">CRM-системы, чат-боты, триггерные рассылки, программы лояльности&nbsp;— весь этот механизм работает, пока клиент чувствует, что за&nbsp;ним стоит человек. Я&nbsp;интегрировал омниканальные программы лояльности на&nbsp;сотню офлайн-магазинов и&nbsp;настраивал коммуникации так, чтобы они продавали.</p>
						<div class="nav-buttons">
							<button class="nav-btn surface-btn" data-target="2">Всплыть ↑</button>
							<button class="nav-btn dive-btn" data-target="4">Погрузиться ↓</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Экран 5: Склад и логистика -->
		<section class="screen screen-5" data-index="4">
			<div class="screen-bg">
				<img src="/floor-5-logistics.jpg" alt="Придонный этаж айсберга: складской фулфилмент и логистика доставки" />
			</div>
			<div class="screen-overlay panel-right">
				<div class="panel">
					<div class="text-inner">
						<span class="floor-tag">05 / 06</span>
						<h2>Товар должен был приехать ещё вчера</h2>
						<p class="annotation">Нужный размер, нужный цвет, красивая упаковка, доставка «вот прям щас»&nbsp;— мы&nbsp;сами создали у&nbsp;клиентов эти ожидания. Я&nbsp;подключал собственные склады, запускал фулфилмент и&nbsp;видел, как правильная логистика даёт мгновенный буст продаж&nbsp;— не&nbsp;маркетинг, а&nbsp;просто товар в&nbsp;наличии.</p>
						<div class="nav-buttons">
							<button class="nav-btn surface-btn" data-target="3">Всплыть ↑</button>
							<button class="nav-btn dive-btn" data-target="5">Погрузиться ↓</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Экран 6: Разработка и ИИ-ядро -->
		<section class="screen screen-6" data-index="5">
			<div class="screen-bg">
				<img src="/floor-6-ai.jpg" alt="Дно айсберга: ИИ-реактор, нейросети и автоматизация разработки" />
			</div>
			<div class="screen-overlay panel-left">
				<div class="panel panel--reactor">
					<div class="text-inner">
						<span class="floor-tag floor-tag--reactor">06 / 06</span>
						<h2 class="neon-pink">То, что было долго, дорого и&nbsp;непонятно,&nbsp;— сегодня делает один человек с&nbsp;ИИ</h2>
						<p class="annotation">Энтерпрайз-разработка должна умереть. Раздутые IT-отделы, годовые бэклоги, миллионные бюджеты&nbsp;— всё это уходит в&nbsp;прошлое. Я&nbsp;верю в&nbsp;формулу «минимальная команда + ИИ-оркестр» и&nbsp;уже применяю её на&nbsp;практике.</p>
						<div class="nav-buttons">
							<button class="nav-btn surface-btn" data-target="4">Всплыть ↑</button>
							<button class="nav-btn dive-btn" data-target="6">А что на дне? ↓</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Футер -->
		<section class="screen screen-footer" data-index="6">
			<Footer />
		</section>

		<!-- Боковые точки-индикаторы -->
		<nav class="dot-nav" aria-label="Навигация по этажам">
			<button class="dot active" data-target="0" aria-label="Экран 1"></button>
			<button class="dot" data-target="1" aria-label="Экран 2"></button>
			<button class="dot" data-target="2" aria-label="Экран 3"></button>
			<button class="dot" data-target="3" aria-label="Экран 4"></button>
			<button class="dot" data-target="4" aria-label="Экран 5"></button>
			<button class="dot" data-target="5" aria-label="Экран 6"></button>
			<button class="dot dot--footer" data-target="6" aria-label="Футер"></button>
		</nav>

	</main>
</Layout>

<style>
	/* ===== FULLPAGE SCROLL-SNAP ===== */
	.fullpage-container {
		width: 100%;
		height: 100vh;
		overflow-y: scroll;
		scroll-snap-type: y mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
	}
	.fullpage-container::-webkit-scrollbar { display: none; }
	.fullpage-container {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	/* ===== SCREEN ===== */
	.screen {
		width: 100%;
		height: 100vh;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		position: relative;
		overflow: hidden;
		transition: filter 0.6s ease;
		filter: brightness(0.3);
	}
	.screen.visible {
		filter: brightness(1);
	}

	/* ===== BACKGROUND IMAGE ===== */
	.screen-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.screen-bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		display: block;
	}

	/* ===== OVERLAY CONTAINER ===== */
	.screen-overlay {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		padding: 4rem 3rem;
	}
	.panel-right {
		justify-content: flex-end;
	}
	.panel-left {
		justify-content: flex-start;
	}

	/* ===== PANEL (TEXT CARD) ===== */
	.panel {
		width: 30%;
		min-width: 320px;
		max-width: 420px;
		background: rgba(10, 14, 26, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 16px;
		padding: 2.5rem 2rem 3.25rem;
	}
	/* Цвета плашек по этажам — из базовой версии */
	.screen-1 .panel { background: rgba(13, 74, 122, 0.7); }
	.screen-2 .panel { background: rgba(8, 50, 86, 0.7); }
	.screen-3 .panel { background: rgba(5, 30, 58, 0.7); }
	.screen-4 .panel { background: rgba(4, 22, 44, 0.7); }
	.screen-5 .panel { background: rgba(3, 14, 30, 0.7); }
	.screen-6 .panel {
		background: rgba(13, 5, 32, 0.7);
		border-color: rgba(139, 92, 246, 0.12);
		box-shadow: 0 0 40px rgba(139, 92, 246, 0.06);
	}

	/* ===== TEXT INNER (анимация входа) ===== */
	.text-inner {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 0.6s ease 0.3s, transform 0.6s ease 0.3s;
	}
	.screen.visible .text-inner {
		opacity: 1;
		transform: translateY(0);
	}

	/* ===== FLOOR TAG ===== */
	.floor-tag {
		display: inline-block;
		font-family: 'Outfit', monospace;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 3px;
		color: rgba(255, 255, 255, 0.45);
		margin-bottom: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 0.5rem;
	}
	.floor-tag--reactor {
		color: rgba(139, 92, 246, 0.6);
		border-color: rgba(139, 92, 246, 0.15);
	}

	/* ===== TYPOGRAPHY ===== */
	.screen h1 {
		font-family: 'Outfit', sans-serif;
		font-size: clamp(1.4rem, 2.5vw, 1.8rem);
		line-height: 1.3;
		color: #f1f5f9;
		margin-bottom: 1rem;
	}
	.screen h2 {
		font-family: 'Outfit', sans-serif;
		font-size: clamp(1.2rem, 2vw, 1.5rem);
		line-height: 1.3;
		color: #f1f5f9;
		margin-bottom: 1rem;
	}
	.neon-pink {
		color: #c084fc;
	}
	.annotation {
		font-size: 0.88rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.8);
		margin-bottom: 1.5rem;
	}

	/* ===== NAV BUTTONS ===== */
	.nav-buttons {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.nav-btn {
		font-family: 'Rajdhani', sans-serif;
		font-weight: 600;
		font-size: 0.8rem;
		padding: 0.45rem 1.2rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.85);
		cursor: pointer;
		transition: all 0.3s ease;
		letter-spacing: 1px;
	}
	.nav-btn:hover {
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
	}
	.dive-btn {
		border-color: rgba(6, 182, 212, 0.5);
		color: #22d3ee;
	}
	.dive-btn:hover {
		background: rgba(6, 182, 212, 0.15);
		color: #67e8f9;
	}

	/* ===== SCREEN BACKGROUNDS ===== */
	.screen-1 { background: #1e3a5f; }
	.screen-2 { background: #0a3d68; }
	.screen-3 { background: #062848; }
	.screen-4 { background: #04162c; }
	.screen-5 { background: #030e1e; }
	.screen-5 .screen-bg img { transform: scaleX(-1); }
	.screen-6 { background: #08051a; }

	.screen-footer {
		display: flex;
		background: linear-gradient(180deg, #0d0520 0%, #030712 100%);
	}

	/* ===== DOT NAV ===== */
	.dot-nav {
		position: fixed;
		right: 1.5rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		z-index: 100;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.2);
		background: transparent;
		cursor: pointer;
		transition: all 0.3s ease;
		padding: 0;
	}
	.dot.active {
		background: var(--accent-cyan, #06b6d4);
		border-color: var(--accent-cyan, #06b6d4);
		box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
	}
	.dot--footer {
		margin-top: 0.5rem;
		width: 6px;
		height: 6px;
	}

	/* ===== RESPONSIVE: мобильная версия как в базовой ===== */
	@media (max-width: 900px) {
		/* Переключаем на стек: картинка сверху, текст снизу */
		.screen {
			display: grid;
			grid-template-columns: 1fr;
			grid-template-rows: 55vh 45vh;
		}

		/* Фон становится обычным блоком в потоке */
		.screen-bg {
			position: relative;
			grid-row: 1;
		}

		/* Overlay становится текстовой панелью */
		.screen-overlay {
			position: relative;
			grid-row: 2;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 1.5rem;
			background: var(--bg-primary, #0a0e1a);
		}

		/* Панель на всю ширину, без стекла */
		.panel, .panel--reactor {
			width: 100%;
			max-width: 100%;
			min-width: unset;
			background: transparent;
			border: none;
			border-radius: 0;
			padding: 0;
		}

		.panel-right, .panel-left {
			justify-content: center;
		}

		/* Фоновые цвета текстовых панелей по этажам */
		.screen-1 .screen-overlay { background: linear-gradient(180deg, rgba(13, 74, 122, 0.95) 0%, rgba(13, 74, 122, 0.7) 100%); }
		.screen-2 .screen-overlay { background: linear-gradient(180deg, rgba(8, 50, 86, 0.95) 0%, rgba(8, 50, 86, 0.7) 100%); }
		.screen-3 .screen-overlay { background: linear-gradient(180deg, rgba(5, 30, 58, 0.95) 0%, rgba(5, 30, 58, 0.7) 100%); }
		.screen-4 .screen-overlay { background: linear-gradient(180deg, rgba(4, 22, 44, 0.95) 0%, rgba(4, 22, 44, 0.7) 100%); }
		.screen-5 .screen-overlay { background: linear-gradient(180deg, rgba(3, 14, 30, 0.95) 0%, rgba(3, 14, 30, 0.7) 100%); }
		.screen-6 .screen-overlay { background: linear-gradient(180deg, rgba(13, 5, 32, 0.95) 0%, rgba(13, 5, 32, 0.7) 100%); }

		.text-inner {
			max-width: 100%;
		}

		.dot-nav {
			right: 0.5rem;
			gap: 8px;
		}
		.dot {
			width: 6px;
			height: 6px;
		}
	}
</style>

<script>
	const container = document.getElementById('fullpage');
	const screens = document.querySelectorAll('.screen');
	const dots = document.querySelectorAll('.dot');

	// Scroll observer
	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('visible');
				const idx = entry.target.dataset.index;
				dots.forEach(d => d.classList.remove('active'));
				const activeDot = document.querySelector(`.dot[data-target="${idx}"]`);
				if (activeDot) activeDot.classList.add('active');
			} else {
				entry.target.classList.remove('visible');
			}
		});
	}, { root: container, threshold: 0.5 });

	screens.forEach(s => observer.observe(s));

	// Click navigation
	document.querySelectorAll('[data-target]').forEach(btn => {
		btn.addEventListener('click', () => {
			const target = parseInt(btn.dataset.target);
			const targetScreen = document.querySelector(`.screen[data-index="${target}"]`);
			if (targetScreen) targetScreen.scrollIntoView({ behavior: 'smooth' });
		});
	});
</script>
