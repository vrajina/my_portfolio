---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ecom Catcher — Мини-игра | Кадацкий" description="Аркадная мини-игра: лови полезные e-commerce термины и уклоняйся от бюрократии!">
	<main class="game-page">
		<div class="game-container" id="gameContainer">
			<canvas id="gameCanvas"></canvas>
		</div>
		<div class="game-footer">
			<a href="/" class="back-link">← На главную</a>
			<span class="game-hint">Стрелки ← → или A/D для управления • Space для старта</span>
		</div>
	</main>
</Layout>

<style>
	.game-page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: #0a0e1a;
	}
	.game-container {
		flex: 1;
		position: relative;
		margin-top: 64px; /* header height */
	}
	#gameCanvas {
		display: block;
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
		cursor: default;
	}
	.game-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1.5rem;
		background: rgba(10, 14, 26, 0.95);
		border-top: 1px solid rgba(0, 240, 255, 0.08);
		z-index: 10;
	}
	.back-link {
		font-family: 'Outfit', sans-serif;
		font-size: 0.85rem;
		color: var(--neon-cyan, #00f0ff);
		text-decoration: none;
		transition: opacity 0.2s;
	}
	.back-link:hover { opacity: 0.7; }
	.game-hint {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.3);
		font-family: 'Inter', sans-serif;
	}
	@media (max-width: 600px) {
		.game-hint { display: none; }
	}
</style>

<script src="/ecom-catcher.js" is:inline></script>
<script is:inline>
	function initGame() {
		var canvas = document.getElementById('gameCanvas');
		if (!canvas || !window.EcomCatcher) return;
		new window.EcomCatcher(canvas);
	}
	document.addEventListener('DOMContentLoaded', initGame);
	document.addEventListener('astro:page-load', initGame);
</script>
