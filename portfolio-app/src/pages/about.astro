---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Обо мне — Илья Кадацкий | E-commerce Executive">
	<Header />

	<main class="about-page">

		<!-- Hero -->
		<section class="about-hero">
			<div class="hero-photo">
				<img src="/photo-ilya.jpg" alt="Илья Кадацкий" />
			</div>
			<div class="hero-text">
				<span class="hero-label">Обо мне</span>
				<h1>Илья Кадацкий</h1>
				<p class="hero-role">E-commerce Executive</p>
				<p class="hero-intro">18&nbsp;лет в&nbsp;диджитале. От&nbsp;первых сайтов в&nbsp;Самаре&nbsp;— до&nbsp;управления e-commerce командами в&nbsp;20+ человек. Строю онлайн-торговлю, которая работает.</p>
				<div class="hero-contacts">
					<a href="https://t.me/ivkadatsky" target="_blank" class="contact-link">Telegram</a>
					<a href="mailto:ilya.kadatsky@yandex.ru" class="contact-link">Email</a>
				</div>
			</div>
		</section>

		<!-- Ключевые цифры -->
		<section class="about-stats">
			<div class="stat">
				<span class="stat-number">18+</span>
				<span class="stat-label">лет в&nbsp;диджитале</span>
			</div>
			<div class="stat">
				<span class="stat-number">6</span>
				<span class="stat-label">компаний, где строил e-com</span>
			</div>
			<div class="stat">
				<span class="stat-number">20+</span>
				<span class="stat-label">человек в&nbsp;команде</span>
			</div>
			<div class="stat">
				<span class="stat-number">100+</span>
				<span class="stat-label">магазинов в&nbsp;омниканалке</span>
			</div>
		</section>

		<!-- Таймлайн карьеры -->
		<section class="about-timeline">
			<h2>Путь в&nbsp;глубину</h2>
			<div class="timeline">

				<div class="timeline-item">
					<div class="timeline-dot"></div>
					<div class="timeline-content">
						<span class="timeline-year">2006–2009</span>
						<h3>Самара. Начало</h3>
						<p class="timeline-company">Веб-мастер → Студия «Доминион»</p>
						<p>Старт карьеры в&nbsp;диджитале. Быстро перешёл от&nbsp;технической роли к&nbsp;управлению проектами. Первые командировки в&nbsp;Москву, пресейл, организация разработки.</p>
					</div>
				</div>

				<div class="timeline-item">
					<div class="timeline-dot"></div>
					<div class="timeline-content">
						<span class="timeline-year">2010–2013</span>
						<h3>Москва. Агентский мир</h3>
						<p class="timeline-company">CreativePeople и&nbsp;другие агентства</p>
						<p>Руководство digital-проектами. Запуск первого интернет-магазина бренда «Эконика»&nbsp;— именно тогда зажёгся интерес к&nbsp;e-commerce.</p>
					</div>
				</div>

				<div class="timeline-item timeline-item--highlight">
					<div class="timeline-dot"></div>
					<div class="timeline-content">
						<span class="timeline-year">2013–2016</span>
						<h3>Thomas Münz. Первое погружение</h3>
						<p class="timeline-company">E-commerce менеджер → руководитель</p>
						<p>Запуск интернет-магазина совместно с&nbsp;Mascotte, затем полный перенос инхаус: собственный колл-центр, склад, подрядчики. Результат&nbsp;— мощный рост продаж. Бренд впоследствии продан корпорации Zenden.</p>
					</div>
				</div>

				<div class="timeline-item">
					<div class="timeline-dot"></div>
					<div class="timeline-content">
						<span class="timeline-year">2016–2019</span>
						<h3>Modi → JV Gallery</h3>
						<p class="timeline-company">E-commerce руководитель</p>
						<p>Запуск онлайн-продаж с&nbsp;нуля для Modi. Погружение в&nbsp;ювелирный рынок в&nbsp;JV&nbsp;Gallery. Прервано COVID.</p>
					</div>
				</div>

				<div class="timeline-item timeline-item--highlight">
					<div class="timeline-dot timeline-dot--gold"></div>
					<div class="timeline-content">
						<span class="timeline-year">2020–2025</span>
						<h3>«Наше золото!». Главный кейс</h3>
						<p class="timeline-company">Руководитель e-commerce</p>
						<p>Команда 20+ человек. Редизайн сайта, собственная фотостудия, запуск мобильного приложения, омниканальная программа лояльности на&nbsp;100 офлайн-магазинов. Рост 15–20% ежегодно.</p>
					</div>
				</div>

				<div class="timeline-item timeline-item--current">
					<div class="timeline-dot timeline-dot--pulse"></div>
					<div class="timeline-content">
						<span class="timeline-year">2025 — настоящее время</span>
						<h3>Finn Flare. ИИ-эксперимент</h3>
						<p class="timeline-company">E-commerce</p>
						<p>Внедрение подхода «минимальная команда + ИИ-оркестр». Эксперимент, который может изменить правила игры.</p>
					</div>
				</div>

			</div>
		</section>

		<!-- Компетенции -->
		<section class="about-skills">
			<h2>Что умею</h2>
			<div class="skills-grid">
				<div class="skill-card">
					<span class="skill-icon">🚀</span>
					<h3>Запуск e-commerce</h3>
					<p>С&nbsp;нуля до&nbsp;первого заказа. Thomas Münz, Modi, «Наше золото!»</p>
				</div>
				<div class="skill-card">
					<span class="skill-icon">👥</span>
					<h3>Построение команд</h3>
					<p>20+ человек: разработка, контент, фотостудия, маркетинг</p>
				</div>
				<div class="skill-card">
					<span class="skill-icon">🔗</span>
					<h3>Омниканальность</h3>
					<p>Интеграция онлайн + 100 офлайн-магазинов, единая программа лояльности</p>
				</div>
				<div class="skill-card">
					<span class="skill-icon">📦</span>
					<h3>Продукт и&nbsp;контент</h3>
					<p>PIM-процессы, фотостудии, контент, который продаёт</p>
				</div>
				<div class="skill-card">
					<span class="skill-icon">📊</span>
					<h3>Стратегия</h3>
					<p>Бюджеты, маркетинг, roadmap, управление ростом</p>
				</div>
				<div class="skill-card">
					<span class="skill-icon">🤖</span>
					<h3>ИИ в&nbsp;разработке</h3>
					<p>Вайбкодинг, AI-оркестр, автоматизация процессов</p>
				</div>
			</div>
		</section>

		<!-- За пределами работы -->
		<section class="about-personal">
			<h2>За&nbsp;пределами работы</h2>
			<div class="personal-grid">
				<div class="personal-item">🏔️ <span>Горы</span></div>
				<div class="personal-item">🏂 <span>Сноуборд</span></div>
				<div class="personal-item">🎬 <span>Кино</span></div>
				<div class="personal-item">🎮 <span>Компьютерные игры</span></div>
				<div class="personal-item">🚶 <span>Прогулки</span></div>
				<div class="personal-item">🎲 <span>Геймдизайн <small>(Red Front&nbsp;— idle RPG)</small></span></div>
			</div>
		</section>

		<!-- CTA -->
		<section class="about-cta">
			<h2>Давайте обсудим ваш проект</h2>
			<p>Ищете e-commerce руководителя или&nbsp;консультанта? Напишите&nbsp;— обсудим.</p>
			<div class="cta-buttons">
				<a href="https://t.me/ivkadatsky" target="_blank" class="cta-btn cta-btn--primary">Написать в&nbsp;Telegram</a>
				<a href="/contacts" class="cta-btn cta-btn--secondary">Все контакты</a>
			</div>
		</section>

	</main>

	<Footer />
</Layout>

<style>
	.about-page {
		padding-top: 70px; /* под фиксированный хедер */
	}

	/* ===== HERO ===== */
	.about-hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: 85vh;
		align-items: center;
		gap: 4rem;
		padding: 4rem 6rem;
		background: linear-gradient(135deg, #0a0e1a 0%, #0d1a2e 50%, #0a1628 100%);
	}
	.hero-photo {
		display: flex;
		justify-content: center;
	}
	.hero-photo img {
		width: 100%;
		max-width: 420px;
		border-radius: 20px;
		border: 1px solid rgba(6, 182, 212, 0.15);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), 0 0 40px rgba(6, 182, 212, 0.05);
	}
	.hero-label {
		display: inline-block;
		font-family: 'Outfit', sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 3px;
		color: var(--accent-cyan, #06b6d4);
		margin-bottom: 1rem;
		border-bottom: 1px solid rgba(6, 182, 212, 0.2);
		padding-bottom: 0.5rem;
	}
	.about-hero h1 {
		font-family: 'Outfit', sans-serif;
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1.15;
		margin-bottom: 0.5rem;
		color: var(--text-primary, #e2e8f0);
	}
	.hero-role {
		font-family: 'Rajdhani', sans-serif;
		font-size: 1.2rem;
		color: var(--accent-cyan, #06b6d4);
		margin-bottom: 1.5rem;
		letter-spacing: 1px;
	}
	.hero-intro {
		font-size: 1.05rem;
		line-height: 1.7;
		color: #b0b8c8;
		margin-bottom: 2rem;
		max-width: 480px;
	}
	.hero-contacts {
		display: flex;
		gap: 1rem;
	}
	.contact-link {
		font-family: 'Rajdhani', sans-serif;
		font-weight: 600;
		font-size: 0.9rem;
		padding: 0.5rem 1.2rem;
		border: 1px solid rgba(6, 182, 212, 0.3);
		border-radius: 4px;
		color: var(--accent-cyan, #06b6d4) !important;
		transition: all 0.3s ease;
		letter-spacing: 1px;
	}
	.contact-link:hover {
		background: rgba(6, 182, 212, 0.1);
		box-shadow: 0 0 15px rgba(6, 182, 212, 0.12);
		text-shadow: none;
	}

	/* ===== STATS ===== */
	.about-stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
		padding: 3.5rem 6rem;
		background: rgba(6, 182, 212, 0.03);
		border-top: 1px solid rgba(6, 182, 212, 0.06);
		border-bottom: 1px solid rgba(6, 182, 212, 0.06);
	}
	.stat {
		text-align: center;
	}
	.stat-number {
		display: block;
		font-family: 'Outfit', sans-serif;
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--accent-cyan, #06b6d4);
		line-height: 1;
		margin-bottom: 0.5rem;
	}
	.stat-label {
		font-size: 0.85rem;
		color: #8892a8;
		line-height: 1.4;
	}

	/* ===== TIMELINE ===== */
	.about-timeline {
		padding: 5rem 6rem;
		max-width: 800px;
		margin: 0 auto;
	}
	.about-timeline h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.6rem;
		color: var(--text-primary, #e2e8f0);
		margin-bottom: 3rem;
		text-align: center;
	}
	.timeline {
		position: relative;
		padding-left: 2.5rem;
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: 6px;
		top: 8px;
		bottom: 8px;
		width: 1px;
		background: linear-gradient(180deg, rgba(6, 182, 212, 0.3) 0%, rgba(139, 92, 246, 0.3) 100%);
	}
	.timeline-item {
		position: relative;
		margin-bottom: 2.5rem;
		padding-left: 1rem;
	}
	.timeline-dot {
		position: absolute;
		left: -2.5rem;
		top: 6px;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: #1a2a40;
		border: 2px solid rgba(6, 182, 212, 0.4);
	}
	.timeline-dot--gold {
		border-color: #f59e0b;
		box-shadow: 0 0 8px rgba(245, 158, 11, 0.3);
	}
	.timeline-dot--pulse {
		border-color: var(--accent-cyan, #06b6d4);
		animation: pulse-dot 2s infinite;
	}
	@keyframes pulse-dot {
		0%, 100% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4); }
		50% { box-shadow: 0 0 0 6px rgba(6, 182, 212, 0); }
	}
	.timeline-year {
		font-family: 'Outfit', monospace;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 2px;
		color: var(--accent-cyan, #06b6d4);
		opacity: 0.7;
	}
	.timeline-content h3 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.1rem;
		color: var(--text-primary, #e2e8f0);
		margin: 0.3rem 0 0.2rem;
	}
	.timeline-company {
		font-size: 0.8rem;
		color: #8892a8;
		margin-bottom: 0.5rem;
		font-style: italic;
	}
	.timeline-content p:last-child {
		font-size: 0.9rem;
		color: #b0b8c8;
		line-height: 1.65;
	}
	.timeline-item--highlight .timeline-content {
		background: rgba(6, 182, 212, 0.04);
		border: 1px solid rgba(6, 182, 212, 0.08);
		border-radius: 12px;
		padding: 1rem 1.2rem;
	}
	.timeline-item--current .timeline-content {
		background: rgba(139, 92, 246, 0.04);
		border: 1px solid rgba(139, 92, 246, 0.1);
		border-radius: 12px;
		padding: 1rem 1.2rem;
	}

	/* ===== SKILLS ===== */
	.about-skills {
		padding: 5rem 6rem;
		background: rgba(255, 255, 255, 0.01);
	}
	.about-skills h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.6rem;
		color: var(--text-primary, #e2e8f0);
		margin-bottom: 2.5rem;
		text-align: center;
	}
	.skills-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		max-width: 960px;
		margin: 0 auto;
	}
	.skill-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 16px;
		padding: 1.5rem;
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.skill-card:hover {
		border-color: rgba(6, 182, 212, 0.15);
		box-shadow: 0 0 20px rgba(6, 182, 212, 0.05);
	}
	.skill-icon {
		font-size: 1.5rem;
		display: block;
		margin-bottom: 0.75rem;
	}
	.skill-card h3 {
		font-family: 'Outfit', sans-serif;
		font-size: 0.95rem;
		color: var(--text-primary, #e2e8f0);
		margin-bottom: 0.4rem;
	}
	.skill-card p {
		font-size: 0.82rem;
		color: #8892a8;
		line-height: 1.5;
	}

	/* ===== PERSONAL ===== */
	.about-personal {
		padding: 4rem 6rem;
		text-align: center;
	}
	.about-personal h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.6rem;
		color: var(--text-primary, #e2e8f0);
		margin-bottom: 2rem;
	}
	.personal-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		max-width: 700px;
		margin: 0 auto;
	}
	.personal-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1.2rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 100px;
		font-size: 0.88rem;
		color: #b0b8c8;
	}
	.personal-item small {
		color: #6b7280;
		font-size: 0.75rem;
	}

	/* ===== CTA ===== */
	.about-cta {
		padding: 5rem 6rem;
		text-align: center;
		background: linear-gradient(180deg, transparent 0%, rgba(6, 182, 212, 0.03) 100%);
		border-top: 1px solid rgba(6, 182, 212, 0.06);
	}
	.about-cta h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.6rem;
		color: var(--text-primary, #e2e8f0);
		margin-bottom: 0.75rem;
	}
	.about-cta p {
		font-size: 1rem;
		color: #8892a8;
		margin-bottom: 2rem;
	}
	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.cta-btn {
		font-family: 'Rajdhani', sans-serif;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 0.7rem 2rem;
		border-radius: 4px;
		letter-spacing: 1px;
		transition: all 0.3s ease;
	}
	.cta-btn--primary {
		background: rgba(6, 182, 212, 0.15);
		border: 1px solid rgba(6, 182, 212, 0.4);
		color: var(--accent-cyan, #06b6d4) !important;
	}
	.cta-btn--primary:hover {
		background: rgba(6, 182, 212, 0.25);
		box-shadow: 0 0 25px rgba(6, 182, 212, 0.15);
		text-shadow: none;
	}
	.cta-btn--secondary {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: rgba(255, 255, 255, 0.6) !important;
	}
	.cta-btn--secondary:hover {
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.9) !important;
		text-shadow: none;
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 900px) {
		.about-hero {
			grid-template-columns: 1fr;
			padding: 3rem 1.5rem;
			gap: 2rem;
			min-height: auto;
			text-align: center;
		}
		.hero-photo img {
			max-width: 280px;
		}
		.hero-intro {
			margin-left: auto;
			margin-right: auto;
		}
		.hero-contacts {
			justify-content: center;
		}
		.about-stats {
			grid-template-columns: repeat(2, 1fr);
			padding: 2.5rem 1.5rem;
		}
		.about-timeline,
		.about-skills,
		.about-personal,
		.about-cta {
			padding: 3rem 1.5rem;
		}
		.skills-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
