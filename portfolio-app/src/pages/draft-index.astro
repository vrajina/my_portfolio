---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Илья Кадацкий | E-commerce Executive" noindex={true}>
	<main class="fullpage-container" id="fullpage">

		<!-- Экран 1: Поверхность -->
		<section class="screen screen-1" data-index="0">
			<div class="screen-illustration">
				<img src="/floor-1-surface.jpg" alt="Эскиз верхушки e-commerce айсберга: покупатель видит только витрину интернет-магазина" />
			</div>
			<aside class="screen-text">
				<div class="text-inner">
					<span class="floor-tag">01 / 05</span>
					<h1>Покупатель видит витрину. Я&nbsp;вижу всё остальное</h1>
					<p class="annotation">Красивый сайт, удобное приложение, товар в&nbsp;корзине&nbsp;— всё это лишь верхушка. Но&nbsp;настоящий e-commerce начинается там, куда покупатель никогда не&nbsp;заглянет. Я&nbsp;провёл 18&nbsp;лет, погружаясь в&nbsp;эту глубину.</p>
					<div class="nav-buttons">
						<button class="nav-btn dive-btn" data-target="1">Погрузиться ↓</button>
					</div>
				</div>
			</aside>
		</section>

		<!-- Экран 2: Продукт и контент -->
		<section class="screen screen-2" data-index="1">
			<div class="screen-illustration">
				<img src="/floor-2-product.jpg" alt="Подводный уровень айсберга: фотостудия, PIM-система и создание диджитал-контента" />
			</div>
			<aside class="screen-text">
				<div class="text-inner">
					<span class="floor-tag">02 / 05</span>
					<h2>Как театр начинается с&nbsp;вешалки, так и&nbsp;e-commerce&nbsp;— с&nbsp;продукта</h2>
					<p class="annotation">Можно бесконечно спорить о&nbsp;конверсионности интерфейсов и&nbsp;качестве трафика. Но&nbsp;успех определяет его величество спрос: насколько ваш продукт в&nbsp;него попадает? Диджитал-контент&nbsp;— это виртуальный аватар вашего товара. Я&nbsp;строил фотостудии, выстраивал PIM-процессы и&nbsp;создавал контент, который продаёт.</p>
					<div class="nav-buttons">
						<button class="nav-btn surface-btn" data-target="0">Всплыть ↑</button>
						<button class="nav-btn dive-btn" data-target="2">Погрузиться ↓</button>
					</div>
				</div>
			</aside>
		</section>

		<!-- Экран 3: Маркетинг и поддержка -->
		<section class="screen screen-3" data-index="2">
			<div class="screen-illustration">
				<img src="/floor-3-marketing.jpg" alt="Глубинный уровень айсберга: маркетинговые каналы, SEO, таргет и бренд-стратегия" />
			</div>
			<aside class="screen-text">
				<div class="text-inner">
					<span class="floor-tag">03 / 05</span>
					<h2>Трафик не&nbsp;появляется из&nbsp;ниоткуда, а&nbsp;клиент не&nbsp;останется сам</h2>
					<p class="annotation">SEO, контекст, таргет, маркетплейсы, инфлюенсеры&nbsp;— каналов десятки. Но&nbsp;привлечь&nbsp;— полдела: CRM, программы лояльности, омниканальные коммуникации на&nbsp;сотню офлайн-точек&nbsp;— вот что превращает трафик в&nbsp;повторные продажи.</p>
					<div class="nav-buttons">
						<button class="nav-btn surface-btn" data-target="1">Всплыть ↑</button>
						<button class="nav-btn dive-btn" data-target="3">Погрузиться ↓</button>
					</div>
				</div>
			</aside>
		</section>

		<!-- Экран 4: Логистика и доставка -->
		<section class="screen screen-4" data-index="3">
			<div class="screen-illustration">
				<img src="/floor-4-logistics.jpg" alt="Придонный этаж айсберга: складской фулфилмент и логистика доставки" />
			</div>
			<aside class="screen-text">
				<div class="text-inner">
					<span class="floor-tag">04 / 05</span>
					<h2>Товар должен был приехать ещё вчера</h2>
					<p class="annotation">Нужный размер, нужный цвет, красивая упаковка, доставка «вот прям щас»&nbsp;— мы&nbsp;сами создали у&nbsp;клиентов эти ожидания. Я&nbsp;подключал собственные склады, запускал фулфилмент и&nbsp;видел, как правильная логистика даёт мгновенный буст продаж&nbsp;— не&nbsp;маркетинг, а&nbsp;просто товар в&nbsp;наличии.</p>
					<div class="nav-buttons">
						<button class="nav-btn surface-btn" data-target="2">Всплыть ↑</button>
						<button class="nav-btn dive-btn" data-target="4">Погрузиться ↓</button>
					</div>
				</div>
			</aside>
		</section>

		<!-- Экран 5: ИИ-ядро -->
		<section class="screen screen-5" data-index="4">
			<div class="screen-illustration screen-illustration--reactor">
				<img src="/floor-5-ai.jpg" alt="Дно айсберга: ИИ-реактор, нейросети и автоматизация разработки" />
			</div>
			<aside class="screen-text screen-text--reactor">
				<div class="text-inner">
					<span class="floor-tag floor-tag--reactor">05 / 05</span>
					<h2 class="neon-pink">То, что было долго, дорого и&nbsp;непонятно,&nbsp;— сегодня делает один человек с&nbsp;ИИ</h2>
					<p class="annotation">Энтерпрайз-разработка должна умереть. Раздутые IT-отделы, годовые бэклоги, миллионные бюджеты&nbsp;— всё это уходит в&nbsp;прошлое. Я&nbsp;верю в&nbsp;формулу «минимальная команда + ИИ-оркестр» и&nbsp;уже применяю её на&nbsp;практике.</p>
					<div class="nav-buttons">
						<button class="nav-btn surface-btn" data-target="3">Всплыть ↑</button>
					</div>
				</div>
			</aside>
		</section>

		<!-- Футер -->
		<section class="screen screen-footer" data-index="5">
			<Footer />
		</section>

		<!-- Боковые точки-индикаторы -->
		<nav class="dot-nav" aria-label="Навигация по этажам">
			<button class="dot active" data-target="0" aria-label="Экран 1"></button>
			<button class="dot" data-target="1" aria-label="Экран 2"></button>
			<button class="dot" data-target="2" aria-label="Экран 3"></button>
			<button class="dot" data-target="3" aria-label="Экран 4"></button>
			<button class="dot" data-target="4" aria-label="Экран 5"></button>
			<button class="dot dot--footer" data-target="5" aria-label="Футер"></button>
		</nav>

	</main>
</Layout>

<style>
	/* ===== FULLPAGE SCROLL-SNAP ===== */
	.fullpage-container {
		width: 100%;
		height: 100vh;
		overflow-y: scroll;
		scroll-snap-type: y mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
	}
	.fullpage-container::-webkit-scrollbar { display: none; }
	.fullpage-container {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	/* ===== SCREEN — TWO-COLUMN LAYOUT ===== */
	.screen {
		width: 100%;
		height: 100vh;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: grid;
		grid-template-columns: 7fr 3fr;
		position: relative;
		overflow: hidden;
		transition: filter 0.6s ease;
		filter: brightness(0.3);
	}
	.screen.visible {
		filter: brightness(1);
	}

	/* ===== LEFT: ILLUSTRATION ===== */
	.screen-illustration {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}
	.screen-illustration img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
	}
	/* Плейсхолдер, пока нет картинок */
	.screen-illustration:empty::after {
		content: 'Иллюстрация';
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Outfit', sans-serif;
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.08);
		letter-spacing: 4px;
	}

	/* ===== RIGHT: TEXT PANEL ===== */
	.screen-text {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 2rem;
		position: relative;
	}
	.text-inner {
		max-width: 380px;
		opacity: 0;
		transform: translateX(20px);
		transition: opacity 0.6s ease 0.3s, transform 0.6s ease 0.3s;
	}
	.screen.visible .text-inner {
		opacity: 1;
		transform: translateX(0);
	}

	/* ===== FLOOR TAG ===== */
	.floor-tag {
		display: inline-block;
		font-family: 'Outfit', monospace;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 3px;
		color: rgba(255, 255, 255, 0.25);
		margin-bottom: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 0.5rem;
	}
	.floor-tag--reactor {
		color: rgba(139, 92, 246, 0.4);
		border-color: rgba(139, 92, 246, 0.15);
	}

	/* ===== SCREEN BACKGROUNDS ===== */
	.screen-1 { background: #1e3a5f; }
	.screen-1 .screen-text { background: linear-gradient(270deg, rgba(13, 74, 122, 0.95) 0%, rgba(13, 74, 122, 0.7) 100%); }

	.screen-2 { background: #0a3d68; }
	.screen-2 .screen-text { background: linear-gradient(270deg, rgba(8, 50, 86, 0.95) 0%, rgba(8, 50, 86, 0.7) 100%); }

	.screen-3 { background: #062848; }
	.screen-3 .screen-text { background: linear-gradient(270deg, rgba(5, 30, 58, 0.95) 0%, rgba(5, 30, 58, 0.7) 100%); }

	.screen-4 { background: #04162c; }
	.screen-4 .screen-text { background: linear-gradient(270deg, rgba(3, 14, 30, 0.95) 0%, rgba(3, 14, 30, 0.7) 100%); }

	.screen-5 { background: #08051a; }
	.screen-5 .screen-text { background: linear-gradient(270deg, rgba(13, 5, 32, 0.95) 0%, rgba(13, 5, 32, 0.7) 100%); }

	.screen-text--reactor {
		border-left: 1px solid rgba(139, 92, 246, 0.15);
		box-shadow: inset 4px 0 30px rgba(139, 92, 246, 0.05);
	}

	.screen-footer {
		display: flex;
		background: linear-gradient(180deg, #0d0520 0%, #030712 100%);
	}

	/* ===== TYPOGRAPHY ===== */
	h1 {
		font-size: clamp(1.3rem, 2.8vw, 2rem);
		line-height: 1.25;
		margin-bottom: 1.2rem;
		color: var(--text-primary, #f1f5f9);
		font-family: 'Outfit', sans-serif;
	}
	h2 {
		font-size: clamp(1.1rem, 2.2vw, 1.5rem);
		line-height: 1.3;
		margin-bottom: 1rem;
		color: var(--accent-cyan, #06b6d4);
		font-family: 'Outfit', sans-serif;
	}
	.reactor-panel h2,
	.screen-text--reactor h2 {
		color: var(--accent-neon, #8b5cf6);
	}
	.annotation {
		font-size: clamp(0.8rem, 1.4vw, 0.95rem);
		line-height: 1.75;
		color: #b0b8c8;
	}

	/* ===== NAV BUTTONS ===== */
	.nav-buttons {
		margin-top: 1.5rem;
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.nav-btn {
		padding: 0.6rem 1.4rem;
		border-radius: 4px;
		font-weight: 600;
		font-size: 0.8rem;
		cursor: pointer;
		font-family: 'Rajdhani', sans-serif;
		transition: all 0.3s ease;
		letter-spacing: 1px;
	}
	.dive-btn {
		background: rgba(6, 182, 212, 0.12);
		border: 1px solid rgba(6, 182, 212, 0.35);
		color: var(--accent-cyan, #06b6d4);
	}
	.dive-btn:hover {
		background: rgba(6, 182, 212, 0.22);
		box-shadow: 0 0 20px rgba(6, 182, 212, 0.15);
	}
	.surface-btn {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: rgba(255, 255, 255, 0.5);
	}
	.surface-btn:hover {
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.85);
	}

	/* ===== DOT NAV ===== */
	.dot-nav {
		position: fixed;
		right: 1.2rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 10px;
		z-index: 1000;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.18);
		cursor: pointer;
		padding: 0;
		transition: all 0.4s ease;
	}
	.dot:hover {
		background: rgba(6, 182, 212, 0.35);
		transform: scale(1.3);
	}
	.dot.active {
		background: var(--accent-cyan, #06b6d4);
		border-color: var(--accent-cyan, #06b6d4);
		box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
		transform: scale(1.2);
	}
	.dot--footer.active {
		background: var(--accent-neon, #8b5cf6);
		border-color: var(--accent-neon, #8b5cf6);
		box-shadow: 0 0 8px rgba(139, 92, 246, 0.4);
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 900px) {
		.screen {
			grid-template-columns: 1fr;
			grid-template-rows: 55vh 45vh;
		}
		.screen-text {
			padding: 1.5rem;
		}
		.text-inner {
			max-width: 100%;
		}
		.dot-nav {
			right: 0.5rem;
			gap: 8px;
		}
		.dot {
			width: 6px;
			height: 6px;
		}
	}
</style>

<script>
	const init = () => {
		const container = document.getElementById('fullpage');
		if (!container) return;

		const screens = container.querySelectorAll('.screen');
		const dots = document.querySelectorAll('.dot');
		const navBtns = document.querySelectorAll('.nav-btn');

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				const el = entry.target as HTMLElement;
				if (entry.isIntersecting) {
					el.classList.add('visible');
					const index = el.dataset.index;
					dots.forEach(dot => dot.classList.remove('active'));
					const activeDot = document.querySelector(`.dot[data-target="${index}"]`);
					if (activeDot) activeDot.classList.add('active');
				} else {
					el.classList.remove('visible');
				}
			});
		}, {
			root: container,
			threshold: 0.5
		});

		screens.forEach(screen => observer.observe(screen));

		dots.forEach(dot => {
			dot.addEventListener('click', () => {
				const target = (dot as HTMLElement).dataset.target;
				const targetScreen = screens[Number(target)];
				if (targetScreen) {
					targetScreen.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});

		navBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const target = (btn as HTMLElement).dataset.target;
				const targetScreen = screens[Number(target)];
				if (targetScreen) {
					targetScreen.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});
	};

	document.addEventListener('DOMContentLoaded', init);
	document.addEventListener('astro:page-load', init);
</script>
