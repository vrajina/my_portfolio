---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Илья Кадацкий | E-commerce Executive">
	<main class="fullpage-container" id="fullpage">

		<!-- Экран 1: Вершина айсберга (поверхность) -->
		<section class="screen screen-1" data-index="0">
			<div class="glass-panel glass-panel--light">
				<h1 class="neon-cyan">Покупатель видит витрину. Я&nbsp;вижу всё остальное</h1>
				<p class="annotation">Красивый сайт, удобное приложение, товар в&nbsp;корзине&nbsp;— всё это лишь верхушка. Но&nbsp;настоящий e-commerce начинается там, куда покупатель никогда не&nbsp;заглянет. Я&nbsp;провёл 18&nbsp;лет, погружаясь в&nbsp;эту глубину&nbsp;— от&nbsp;первых сайтов в&nbsp;Самаре до&nbsp;управления командами в&nbsp;20+ человек. Добро пожаловать под воду.</p>
				<div class="nav-buttons">
					<button class="nav-btn dive-btn" data-target="1">Погрузиться ↓</button>
				</div>
			</div>
			<div class="floor-indicator">01 / 06</div>
		</section>

		<!-- Экран 2: Продукт и контент -->
		<section class="screen screen-2" data-index="1">
			<div class="glass-panel">
				<h2>Как театр начинается с&nbsp;вешалки, так и&nbsp;e-commerce&nbsp;— с&nbsp;продукта</h2>
				<p class="annotation">Можно бесконечно спорить о&nbsp;конверсионности интерфейсов и&nbsp;качестве трафика. Но&nbsp;успех определяет его величество спрос: насколько ваш продукт в&nbsp;него попадает и&nbsp;насколько он&nbsp;конкурентоспособен? Диджитал-контент&nbsp;— это виртуальный аватар вашего товара, мост между ожиданиями клиента и&nbsp;реальностью. Я&nbsp;строил фотостудии, выстраивал PIM-процессы и&nbsp;создавал контент, который продаёт&nbsp;— силами собственных команд, без аутсорса.</p>
				<div class="nav-buttons">
					<button class="nav-btn surface-btn" data-target="0">Всплыть ↑</button>
					<button class="nav-btn dive-btn" data-target="2">Погрузиться ↓</button>
				</div>
			</div>
			<div class="floor-indicator">02 / 06</div>
		</section>

		<!-- Экран 3: Маркетинг и продвижение -->
		<section class="screen screen-3" data-index="2">
			<div class="glass-panel">
				<h2>Трафик не&nbsp;появляется из&nbsp;ниоткуда, а&nbsp;бренд не&nbsp;строится сам</h2>
				<p class="annotation">SEO, контекст, таргет, маркетплейсы, инфлюенсеры&nbsp;— каналов десятки, и&nbsp;каждый живёт по&nbsp;своим правилам. Но&nbsp;самое сложное&nbsp;— не&nbsp;настроить рекламу, а&nbsp;убедить бизнес вложиться в&nbsp;бренд, когда ROI нельзя посчитать за&nbsp;неделю. Я&nbsp;прошёл этот путь: от&nbsp;микробюджетов до&nbsp;стратегий, которые меняют восприятие целой компании.</p>
				<div class="nav-buttons">
					<button class="nav-btn surface-btn" data-target="1">Всплыть ↑</button>
					<button class="nav-btn dive-btn" data-target="3">Погрузиться ↓</button>
				</div>
			</div>
			<div class="floor-indicator">03 / 06</div>
		</section>

		<!-- Экран 4: Поддержка и коммуникации -->
		<section class="screen screen-4" data-index="3">
			<div class="glass-panel">
				<h2>Мы&nbsp;так увлеклись автоматизацией, что люди заскучали по&nbsp;живым операторам</h2>
				<p class="annotation">CRM-системы, чат-боты, триггерные рассылки, программы лояльности&nbsp;— весь этот механизм работает, пока клиент чувствует, что за&nbsp;ним стоит человек, а&nbsp;не&nbsp;скрипт. Я&nbsp;интегрировал омниканальные программы лояльности на&nbsp;сотню офлайн-магазинов, собирал колл-центры и&nbsp;настраивал коммуникации так, чтобы они продавали, а&nbsp;не&nbsp;раздражали.</p>
				<div class="nav-buttons">
					<button class="nav-btn surface-btn" data-target="2">Всплыть ↑</button>
					<button class="nav-btn dive-btn" data-target="4">Погрузиться ↓</button>
				</div>
			</div>
			<div class="floor-indicator">04 / 06</div>
		</section>

		<!-- Экран 5: Логистика и доставка -->
		<section class="screen screen-5" data-index="4">
			<div class="glass-panel">
				<h2>Товар должен был приехать ещё вчера</h2>
				<p class="annotation">Нужный размер, нужный цвет, красивая упаковка, доставка «вот прям щас»&nbsp;— мы&nbsp;сами создали у&nbsp;клиентов эти ожидания, нам и&nbsp;пожинать плоды. Я&nbsp;подключал собственные склады, запускал фулфилмент-процессы и&nbsp;видел, как правильная логистика даёт мгновенный буст продаж&nbsp;— не&nbsp;маркетинг, не&nbsp;редизайн, а&nbsp;просто товар, который наконец-то есть в&nbsp;наличии.</p>
				<div class="nav-buttons">
					<button class="nav-btn surface-btn" data-target="3">Всплыть ↑</button>
					<button class="nav-btn dive-btn" data-target="5">Погрузиться ↓</button>
				</div>
			</div>
			<div class="floor-indicator">05 / 06</div>
		</section>

		<!-- Экран 6: ИИ-ядро и технологии -->
		<section class="screen screen-6" data-index="5">
			<div class="glass-panel reactor-panel">
				<h2 class="neon-pink">То, что было долго, дорого и&nbsp;непонятно,&nbsp;— сегодня делает один человек с&nbsp;ИИ</h2>
				<p class="annotation">Энтерпрайз-разработка должна умереть. Раздутые IT-отделы, годовые бэклоги, миллионные бюджеты на&nbsp;поддержку&nbsp;— всё это уходит в&nbsp;прошлое. Я&nbsp;верю в&nbsp;формулу «минимальная команда + ИИ-оркестр» и&nbsp;уже применяю её на&nbsp;практике. Здесь, на&nbsp;самом дне айсберга, мерцает реактор&nbsp;— средоточие вычислительных мощностей, которые меняют правила игры.</p>
				<div class="nav-buttons">
					<button class="nav-btn surface-btn" data-target="4">Всплыть ↑</button>
				</div>
			</div>
			<div class="floor-indicator">06 / 06</div>
		</section>

		<!-- Футер -->
		<section class="screen screen-footer" data-index="6">
			<Footer />
		</section>

		<!-- Боковые точки-индикаторы -->
		<nav class="dot-nav" aria-label="Навигация по этажам">
			<button class="dot active" data-target="0" aria-label="Экран 1"></button>
			<button class="dot" data-target="1" aria-label="Экран 2"></button>
			<button class="dot" data-target="2" aria-label="Экран 3"></button>
			<button class="dot" data-target="3" aria-label="Экран 4"></button>
			<button class="dot" data-target="4" aria-label="Экран 5"></button>
			<button class="dot" data-target="5" aria-label="Экран 6"></button>
			<button class="dot dot--footer" data-target="6" aria-label="Футер"></button>
		</nav>

	</main>
</Layout>

<style>
	/* ===== FULLPAGE SCROLL-SNAP CONTAINER ===== */
	.fullpage-container {
		width: 100%;
		height: 100vh;
		overflow-y: scroll;
		scroll-snap-type: y mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
	}

	/* Hide scrollbar but keep scroll functionality */
	.fullpage-container::-webkit-scrollbar {
		display: none;
	}
	.fullpage-container {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	/* ===== INDIVIDUAL SCREENS ===== */
	.screen {
		width: 100%;
		height: 100vh;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		transition: filter 0.6s ease;
		filter: brightness(0.3);
	}
	.screen.visible {
		filter: brightness(1);
	}

	/* ===== CINEMATIC PANEL ANIMATION ===== */
	.glass-panel {
		opacity: 0;
		transform: translateY(30px) scale(0.95);
		transition: opacity 0.6s ease 0.2s, transform 0.6s ease 0.2s;
	}
	.screen.visible .glass-panel {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	/* ===== SCREEN BACKGROUNDS ===== */
	/* Экран 1: Поверхность — светлый, небо + вода */
	.screen-1 {
		background: 
			linear-gradient(180deg, 
				rgba(30, 58, 95, 0.6) 0%, 
				rgba(26, 74, 110, 0.4) 30%,
				rgba(21, 101, 160, 0.3) 60%, 
				rgba(13, 74, 122, 0.5) 100%),
			url('/test_iceberg_01.jpg') center bottom / auto no-repeat;
	}

	/* Экран 2: Продукт */
	.screen-2 {
		background: linear-gradient(180deg, 
			#0d4a7a 0%, 
			#0a3d68 40%, 
			#083256 100%);
	}

	/* Экран 3: Маркетинг */
	.screen-3 {
		background: linear-gradient(180deg, 
			#083256 0%, 
			#062848 40%, 
			#051e3a 100%);
	}

	/* Экран 4: Коммуникации */
	.screen-4 {
		background: linear-gradient(180deg, 
			#051e3a 0%, 
			#04162c 40%, 
			#030e1e 100%);
	}

	/* Экран 5: Логистика */
	.screen-5 {
		background: linear-gradient(180deg, 
			#030e1e 0%, 
			#061428 40%, 
			#08051a 100%);
	}

	/* Экран 6: ИИ-ядро — самый тёмный, с фиолетовым свечением реактора */
	.screen-6 {
		background: linear-gradient(180deg, 
			#08051a 0%, 
			#0a0618 40%, 
			#0d0520 100%);
	}

	.screen-footer {
		background: linear-gradient(180deg, 
			#0d0520 0%, 
			#030712 100%);
	}

	/* ===== GLASS PANELS ===== */
	.glass-panel {
		max-width: 680px;
		padding: 3rem 2.5rem;
		background: rgba(255, 255, 255, 0.04);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 24px;
		text-align: center;
	}

	.glass-panel--light {
		background: rgba(255, 255, 255, 0.07);
		border-color: rgba(255, 255, 255, 0.12);
	}

	.reactor-panel {
		border-color: rgba(139, 92, 246, 0.3);
		box-shadow: 
			0 0 60px rgba(139, 92, 246, 0.15),
			inset 0 0 30px rgba(139, 92, 246, 0.05);
	}

	/* ===== TYPOGRAPHY ===== */
	h1 {
		font-size: clamp(1.44rem, 3.2vw, 2.4rem);
		line-height: 1.2;
		margin-bottom: 1.5rem;
		color: var(--text-primary, #f1f5f9);
		font-family: 'Outfit', sans-serif;
	}

	h2 {
		font-size: clamp(1.12rem, 2.4vw, 1.76rem);
		line-height: 1.3;
		margin-bottom: 1.2rem;
		color: var(--accent-cyan, #06b6d4);
		font-family: 'Outfit', sans-serif;
	}

	.reactor-panel h2 {
		color: var(--accent-neon, #8b5cf6);
	}

	.annotation {
		font-size: clamp(0.875rem, 1.65vw, 1.06rem);
		line-height: 1.7;
		color: #c8d0e0;
		max-width: 560px;
		margin: 0 auto;
	}

	/* ===== FLOOR INDICATOR (bottom-right) ===== */
	.floor-indicator {
		position: absolute;
		bottom: 2rem;
		right: 2rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 2px;
		color: rgba(255, 255, 255, 0.15);
		font-family: 'Outfit', monospace;
	}

	/* ===== NAVIGATION BUTTONS ===== */
	.nav-buttons {
		margin-top: 2rem;
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.nav-btn {
		padding: 0.7rem 1.8rem;
		border-radius: 4px;
		font-weight: 600;
		font-size: 0.9rem;
		cursor: pointer;
		font-family: 'Rajdhani', sans-serif;
		transition: all 0.3s ease;
		letter-spacing: 1.5px;
	}

	.dive-btn {
		background: rgba(6, 182, 212, 0.15);
		border: 1px solid rgba(6, 182, 212, 0.4);
		color: var(--accent-cyan, #06b6d4);
	}

	.dive-btn:hover {
		background: rgba(6, 182, 212, 0.25);
		box-shadow: 0 0 30px rgba(6, 182, 212, 0.2);
	}

	.surface-btn {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.6);
	}

	.surface-btn:hover {
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.9);
		box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
	}

	/* ===== DOT NAVIGATION ===== */
	.dot-nav {
		position: fixed;
		right: 1.5rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 12px;
		z-index: 1000;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		border: 1px solid rgba(255, 255, 255, 0.2);
		cursor: pointer;
		padding: 0;
		transition: all 0.4s ease;
	}

	.dot:hover {
		background: rgba(6, 182, 212, 0.4);
		transform: scale(1.3);
	}

	.dot.active {
		background: var(--accent-cyan, #06b6d4);
		border-color: var(--accent-cyan, #06b6d4);
		box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
		transform: scale(1.2);
	}

	.dot--footer.active {
		background: var(--accent-neon, #8b5cf6);
		border-color: var(--accent-neon, #8b5cf6);
		box-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 768px) {
		.glass-panel {
			margin: 0 1rem;
			padding: 2rem 1.5rem;
		}

		.dot-nav {
			right: 0.75rem;
			gap: 10px;
		}

		.dot {
			width: 8px;
			height: 8px;
		}

		.floor-indicator {
			bottom: 1rem;
			right: 1rem;
			font-size: 0.7rem;
		}

		.nav-buttons {
			flex-direction: column;
			align-items: center;
		}
	}
</style>

<script>
	const init = () => {
		const container = document.getElementById('fullpage');
		if (!container) return;

		const screens = container.querySelectorAll('.screen');
		const dots = document.querySelectorAll('.dot');
		const navBtns = document.querySelectorAll('.nav-btn');

		// Cinematic: visibility + dot navigation
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				const el = entry.target as HTMLElement;
				if (entry.isIntersecting) {
					el.classList.add('visible');
					const index = el.dataset.index;
					dots.forEach(dot => dot.classList.remove('active'));
					const activeDot = document.querySelector(`.dot[data-target="${index}"]`);
					if (activeDot) activeDot.classList.add('active');
				} else {
					el.classList.remove('visible');
				}
			});
		}, {
			root: container,
			threshold: 0.5
		});

		screens.forEach(screen => observer.observe(screen));

		// Dot click navigation
		dots.forEach(dot => {
			dot.addEventListener('click', () => {
				const target = (dot as HTMLElement).dataset.target;
				const targetScreen = screens[Number(target)];
				if (targetScreen) {
					targetScreen.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});

		// Nav button navigation
		navBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const target = (btn as HTMLElement).dataset.target;
				const targetScreen = screens[Number(target)];
				if (targetScreen) {
					targetScreen.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});
	};

	document.addEventListener('DOMContentLoaded', init);
	document.addEventListener('astro:page-load', init);
</script>
